"""Offline tests for scripts/evaluate_mohler.py (no dataset download). Rows mimic the dataset's schema."""
import importlib.util
from pathlib import Path

import pytest

spec = importlib.util.spec_from_file_location(
    "evaluate_mohler", Path(__file__).resolve().parents[1] / "scripts" / "evaluate_mohler.py")
em = importlib.util.module_from_spec(spec)
spec.loader.exec_module(em)

Q = "What is the role of a prototype program in problem solving?"
REF = "To simulate the behaviour of portions of the desired software product."


def row(i, q, ans, s1, s2, avg, ex="E01"):
    return {"id": f"{ex}.Q{q:02d}.A{i:02d}", "question": Q, "instructor_answer": REF,
            "student_answer": ans, "score_grader_1": s1, "score_grader_2": s2, "score_avg": avg}


ROWS = [
    row(0, 1, "A program that simulates the behavior of portions of the desired software product.", 5, 5, 5),
    row(1, 1, "To find problem and errors in a program before it is finalized", 2, 2, 2),
    row(2, 2, "it simulates the behavior of portions of the desired software product<br>", 5, 5, 5),
    row(3, 2, "in the testing phase", 0, 0, 0),
    row(4, 3, "Simulating the behavior of only a portion of the desired software product.", 5, 5, 5),
    row(5, 3, "", 0, 0, 0),
    row(6, 4, "It tests the main function while leaving out finer details.", 2, 2, 2),
    row(7, 4, "To simulate portions of the desired final product", 5, 4, 4.5, ex="E11"),
]


def test_clean_strips_html():
    assert em.clean("a<br><br>b &amp; c<br/>") == "a b & c"


def test_split_is_by_question_and_disjoint():
    dev, test = em.split_by_question(ROWS, 0.5, 42)
    assert {em.question_key(r) for r in dev}.isdisjoint({em.question_key(r) for r in test})
    assert len(dev) + len(test) == len(ROWS) and dev and test


def test_ten_point_exercises_are_rescaled():
    r = row(0, 1, "x", 10, 6, 4, ex="E11")
    assert em.grader_on_5(r, "score_grader_1") == 5 and em.grader_on_5(r, "score_grader_2") == 3
    assert em.grader_on_5(row(0, 1, "x", 4, 3, 3.5), "score_grader_1") == 4


def test_half_up_rounding_not_bankers():
    import numpy as np
    assert list(em._round_half_up(np.array([2.5, 3.5, 4.5]))) == [3, 4, 5]


def test_metrics_perfect_and_constant():
    m = em.metrics([5, 2.5, 0, 5], [5, 2.5, 0, 5])
    assert m["mae"] == 0 and m["pearson"] == pytest.approx(1) and m["qwk"] == pytest.approx(1)
    assert em.metrics([5, 5, 5], [5, 3, 1])["pearson"] is None  # constant prediction: undefined, must not crash


def test_grading_runs_and_separates_good_from_bad():
    pred, flagged = em.grade_rows(ROWS, encoder=None)
    assert pred[0] == 5 and pred[3] == 0 and pred[5] == 0 and flagged[5]  # empty answer flagged


def test_report_renders_without_network():
    dev, test = em.split_by_question(ROWS, 0.5, 42)
    pred, flagged = em.grade_rows(test, None)
    text = em.report(dev, test, pred, flagged, (0.7, 0.4), False, None)
    assert "Gradient draft" in text and "Human ceiling" in text
